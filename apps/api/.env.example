NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Server-only values. Never expose these in the mobile app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# KI Mentor. Provider API keys are server-only and must never reach the mobile app.
# Mentor routes are only registered when enabled. Requires the mentor migration.
MENTOR_ENABLED=false
# mock = no network, no costs. anthropic requires ANTHROPIC_API_KEY (server-only).
MENTOR_PROVIDER=mock
ANTHROPIC_API_KEY=
MENTOR_ANTHROPIC_MODEL=claude-sonnet-5-5
MENTOR_ANTHROPIC_EFFORT=low
MENTOR_PROVIDER_TIMEOUT_MS=30000
MENTOR_MAX_OUTPUT_TOKENS=4096
MENTOR_HISTORY_MESSAGES=20
MENTOR_DAILY_MESSAGE_LIMIT=30
MENTOR_BURST_LIMIT_PER_MINUTE=6
MENTOR_QUOTA_TIME_ZONE=Europe/Berlin
